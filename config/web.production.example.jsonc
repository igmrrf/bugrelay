{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bugrelay-web",
  "main": "../frontend/.open-next/worker.js",
  "account_id": "REPLACE_WITH_VERIFIED_ACCOUNT_ID",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory":"../frontend/.open-next/assets","binding":"ASSETS"},
  "services": [{"binding":"API","service":"bugrelay-api"}],
  "routes": [{"pattern":"bugrelay.com","custom_domain":true}],
  "observability": {"enabled":true,"logs":{"invocation_logs":false}}
}
