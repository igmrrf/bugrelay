[Unit]
Description=BugRelay Backend Service
Documentation=https://docs.bugrelay.com
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service
Requires=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/bugrelay/backend
ExecStart=/opt/bugrelay/backend/bugrelay-backend
ExecReload=/bin/kill -HUP $MAINPID

# Graceful shutdown configuration
ExecStop=/bin/kill -TERM $MAINPID
TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM

# Restart configuration
Restart=always
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

# Environment configuration
Environment=PORT=8080
Environment=GIN_MODE=release
EnvironmentFile=-/opt/bugrelay/backend/.env

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bugrelay/backend /var/log/bugrelay /tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
LimitCORE=0

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bugrelay-backend

# Health check (optional - requires systemd 240+)
# ExecStartPost=/bin/sleep 5
# ExecStartPost=/usr/bin/curl -f http://localhost:8080/health || exit 1

[Install]
WantedBy=multi-user.target
Alias=backend.service